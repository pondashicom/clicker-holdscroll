<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Clicker-HoldScroll</AssemblyName>
    <RootNamespace>ArrowWheel</RootNamespace>
    <Version>0.4.1</Version>
    <Product>Clicker HoldScroll</Product>
    <Description>左右矢印キーの短押しと長押しを使い分ける常駐ツール</Description>
    <ApplicationIcon>..\..\assets\clicker-holdscroll.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\clicker-holdscroll.ico"
                      Link="Assets\clicker-holdscroll.ico"
                      LogicalName="ArrowWheel.clicker-holdscroll.ico" />
  </ItemGroup>
</Project>
